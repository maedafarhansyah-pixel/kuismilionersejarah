function startGame(){
  ensureAudio();
  document.getElementById('startScreen').style.display = 'none';
  document.getElementById('gameHud').classList.add('active');
  state.questions = shuffle(BANK_SOAL).slice(0, TOTAL_Q);
  state.currentIndex = 0; state.answers = [];
  state.score = 0; state.xp = 0; state.level = 1;
  state.hp = state.maxHp; state.combo = 0; state.bestCombo = 0;
  state.timeLeft = TIME_LIMIT; state.started = true; state.finished = false;
  state.powers = { p50:1, hint:1, skip:1 };
  updateHpHud(); updateXpHud(); updateComboHud(); updatePowers();
  showToast('🏛️', 'Arena Level 16 Dimulai!', 'Kuasai teori & kerajaan awal Hindu-Buddha!', '');
  sfxClick();
  startTimer();
  renderQuestion();
}

function startTimer(){
  if (state.timer) clearInterval(state.timer);
  state.timer = setInterval(() => {
    state.timeLeft--;
    updateTimerHud();
    if (state.timeLeft <= 0){ clearInterval(state.timer); finishGame(true); }
  }, 1000);
  updateTimerHud();
}
function updateTimerHud(){
  const m = Math.floor(state.timeLeft / 60), s = state.timeLeft % 60;
  document.getElementById('hudTimerVal').textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
  const el = document.getElementById('hudTimer');
  if (state.timeLeft <= 120) el.classList.add('warning'); else el.classList.remove('warning');
}

function renderQuestion(){
  const q = state.questions[state.currentIndex];
  if (!q) return;
  document.getElementById('qNumLabel').textContent = 'Soal ' + (state.currentIndex+1);
  document.getElementById('qTopicText').textContent = q.topic || 'Hindu-Buddha';
  document.getElementById('qText').innerHTML = q.question;
  document.getElementById('hudQNum').textContent = state.currentIndex+1;
  const opts = document.getElementById('options'); opts.innerHTML = '';
  q.options.forEach(o => {
    const btn = document.createElement('button');
    btn.className = 'opt';
    btn.dataset.letter = o.letter;
    btn.innerHTML = `<span class="opt-letter">${o.letter}</span><span class="opt-text">${o.text}</span>`;
    btn.addEventListener('click', () => selectOption(o.letter, btn));
    opts.appendChild(btn);
  });
  document.getElementById('feedback').classList.remove('show');
  document.getElementById('btnNext').disabled = true;
  document.getElementById('btnNext').style.display = '';
  document.getElementById('btnFinish').style.display = 'none';
  document.getElementById('qCard').classList.remove('shake');
  const card = document.getElementById('qCard');
  card.style.animation = 'none'; void card.offsetWidth;
  card.style.animation = 'qEnter .55s cubic-bezier(.16,1,.3,1)';
  if (state.currentIndex === TOTAL_Q - 1){
    document.getElementById('btnNext').style.display = 'none';
    document.getElementById('btnFinish').style.display = '';
  }
}

function selectOption(letter, btnEl){
  const q = state.questions[state.currentIndex];
  if (!q) return;
  if (state.answers.find(a => a.qid === q.id)) return;
  const selected = q.options.find(o => o.letter === letter);
  if (!selected) return;
  const correct = selected.correct;
  document.querySelectorAll('#options .opt').forEach(b => {
    b.classList.add('locked');
    const o = q.options.find(x => x.letter === b.dataset.letter);
    if (o.correct) b.classList.add('correct');
    else if (b.dataset.letter === letter && !correct) b.classList.add('wrong');
  });
  state.answers.push({ qid: q.id, selected: letter, correct, skipped: false,
    questionText: q.question, topic: q.topic,
    correctLetter: q.options.find(o => o.correct).letter,
    explanation: selected.explanation });
  if (correct){
    state.combo++;
    if (state.combo > state.bestCombo) state.bestCombo = state.combo;
    const bonus = Math.max(0, state.combo - 1) * 5;
    const gained = (q.points || 50) + bonus;
    state.score += gained; state.xp += gained;
    const prevLevel = state.level;
    state.level = Math.floor(state.xp / 100) + 1;
    if (state.level > prevLevel){
      sfxLevelUp();
      showToast('⭐', 'LEVEL UP!', `Kamu naik ke Level ${state.level}!`, 'cyan');
      fireConfetti(40);
    }
    sfxCorrect();
    fireConfetti(state.combo >= 3 ? 80 : 45);
    const rect = btnEl ? btnEl.getBoundingClientRect() : null;
    scorePopup('+' + gained + ' XP', rect ? rect.left + rect.width/2 : window.innerWidth/2, rect ? rect.top : window.innerHeight/2, '#FCD34D');
    if (state.combo >= 3) showToast('🔥', `COMBO ×${state.combo}!`, `Bonus +${bonus} XP!`, '');
  } else {
    state.combo = 0; state.hp--; sfxWrong();
    updateHpHud();
    const hpEls = document.querySelectorAll('.hud-hp .heart');
    if (hpEls[state.hp]) hpEls[state.hp].classList.add('losing');
    const card = document.getElementById('qCard');
    card.classList.add('shake'); setTimeout(() => card.classList.remove('shake'), 550);
    if (state.hp <= 0) showToast('💔', 'Nyawa Habis!', 'Kamu kehilangan semua nyawa.', 'violet');
  }
  document.getElementById('hudScore').textContent = state.score;
  updateXpHud(); updateComboHud();
  showFeedback(correct, q, selected);
  document.getElementById('btnNext').disabled = false;
}

function showFeedback(correct, q, selected){
  const panel = document.getElementById('feedback');
  const icon = document.getElementById('fbIcon');
  const title = document.getElementById('fbTitle');
  const body = document.getElementById('fbBody');
  panel.classList.add('show');
  if (correct){
    icon.className = 'fb-icon correct'; icon.innerHTML = '<i class="fas fa-check"></i>';
    title.className = 'fb-title correct'; title.textContent = 'BENAR!';
  } else {
    icon.className = 'fb-icon wrong'; icon.innerHTML = '<i class="fas fa-times"></i>';
    title.className = 'fb-title wrong'; title.textContent = 'BELUM TEPAT';
  }
  const correctOpt = q.options.find(o => o.correct);
  let html = `<p><strong>Jawaban benar: ${correctOpt.letter}.</strong> ${correctOpt.text}</p>`;
  html += `<div class="fb-sec"><div class="fb-label"><i class="fas fa-lightbulb"></i> Mengapa Jawaban Ini Benar</div><p>${correctOpt.explanation || ''}</p></div>`;
  if (!correct && selected) html += `<div class="fb-sec"><div class="fb-label"><i class="fas fa-exclamation-triangle"></i> Analisis Pilihanmu</div><p>Pilihan ${selected.letter} kurang tepat: ${selected.explanation || ''}</p></div>`;
  html += `<div class="fb-points"><div class="fb-label"><i class="fas fa-star"></i> Poin Kunci</div><p>${q.hint || ''}</p></div>`;
  body.innerHTML = html;
}

function nextQuestion(){
  if (state.currentIndex < TOTAL_Q - 1){
    state.currentIndex++;
    renderQuestion();
    document.getElementById('qCard').scrollIntoView({ behavior:'smooth', block:'start' });
  }
}

function usePower(type){
  const q = state.questions[state.currentIndex];
  if (!q) return;
  if (state.answers.find(a => a.qid === q.id)) return;
  if (type === '50'){
    if (state.powers.p50 <= 0) return;
    const wrongs = q.options.filter(o => !o.correct);
    const remove = shuffle(wrongs).slice(0, 2);
    document.querySelectorAll('#options .opt').forEach(b => {
      if (remove.some(o => o.letter === b.dataset.letter)) b.classList.add('disabled-50');
    });
    state.powers.p50 = 0; updatePowers(); sfxPower();
    showToast('✂️', '50:50 Aktif!', 'Dua jawaban salah dihilangkan.', 'cyan');
  } else if (type === 'hint'){
    if (state.powers.hint <= 0) return;
    const panel = document.getElementById('feedback');
    const icon = document.getElementById('fbIcon');
    const title = document.getElementById('fbTitle');
    const body = document.getElementById('fbBody');
    panel.classList.add('show');
    icon.className = 'fb-icon info'; icon.innerHTML = '<i class="fas fa-lightbulb"></i>';
    title.className = 'fb-title info'; title.textContent = 'PETUNJUK';
    body.innerHTML = `<p>${q.hint || 'Tidak ada petunjuk.'}</p>`;
    state.powers.hint = 0; updatePowers(); sfxPower();
    showToast('💡', 'Petunjuk Digunakan!', 'Perhatikan dengan saksama.', '');
  } else if (type === 'skip'){
    if (state.powers.skip <= 0) return;
    state.answers.push({ qid: q.id, selected: null, correct: false, skipped: true,
      questionText: q.question, topic: q.topic,
      correctLetter: q.options.find(o => o.correct).letter,
      explanation: q.options.find(o => o.correct).explanation });
    document.querySelectorAll('#options .opt').forEach(b => {
      b.classList.add('locked');
      const o = q.options.find(x => x.letter === b.dataset.letter);
      if (o.correct) b.classList.add('correct');
    });
    showFeedback(false, q, null);
    document.getElementById('btnNext').disabled = false;
    state.powers.skip = 0; updatePowers(); sfxPower();
    showToast('⏭️', 'Soal Dilewati', 'Jawaban benar ditampilkan.', 'violet');
    if (state.currentIndex === TOTAL_Q - 1){
      document.getElementById('btnNext').style.display = 'none';
      document.getElementById('btnFinish').style.display = '';
    }
  }
}

function finishGame(timeout){
  if (state.finished) return;
  state.finished = true;
  clearInterval(state.timer); state.timer = null;
  const answered = state.answers.map(a => a.qid);
  state.questions.forEach(q => {
    if (!answered.includes(q.id)){
      state.answers.push({ qid: q.id, selected: null, correct: false, skipped: true,
        questionText: q.question, topic: q.topic,
        correctLetter: q.options.find(o => o.correct).letter,
        explanation: q.options.find(o => o.correct).explanation });
    }
  });
  let benar = 0, salah = 0;
  state.answers.forEach(a => { if (a.skipped) return; if (a.correct) benar++; else salah++; });
  const maxScore = state.questions.reduce((s, q) => s + (q.points || 50), 0);
  const finalScore = Math.round((state.score / maxScore) * 100);
  const grade = finalScore >= 90 ? 'A' : finalScore >= 80 ? 'B' : finalScore >= 70 ? 'C' : finalScore >= 60 ? 'D' : 'E';
  const gradeLabel = finalScore >= 90 ? 'Sangat Baik' : finalScore >= 80 ? 'Baik' : finalScore >= 70 ? 'Cukup' : finalScore >= 60 ? 'Perlu Bimbingan' : 'Remedial';
  const rank = finalScore >= 90 ? 'ARKEOLOG MUDA' : finalScore >= 80 ? 'PENELITI SEJARAH' : finalScore >= 70 ? 'PELAJAR SEJARAH' : 'PEMULA';
  const trophy = finalScore >= 90 ? '🏆' : finalScore >= 80 ? '🥇' : finalScore >= 70 ? '🥈' : finalScore >= 60 ? '🥉' : '📚';
  const title = finalScore >= 90 ? 'Luar Biasa!' : finalScore >= 80 ? 'Kerja Bagus!' : finalScore >= 70 ? 'Terus Belajar!' : 'Jangan Menyerah!';
  document.getElementById('gameHud').classList.remove('active');
  document.getElementById('resultScreen').classList.add('active');
  document.getElementById('rTrophy').textContent = trophy;
  document.getElementById('rTitle').textContent = title;
  document.getElementById('rSub').textContent = 'Kuis 16 · Teori Masuk & Kerajaan Awal Hindu-Buddha';
  document.getElementById('gradeLetter').textContent = grade;
  document.getElementById('gradeLabel').textContent = gradeLabel;
  document.getElementById('rRank').textContent = rank;
  document.getElementById('rXp').textContent = state.xp;
  document.getElementById('rBestCombo').textContent = state.bestCombo;
  document.getElementById('rBenar').textContent = benar;
  document.getElementById('rSalah').textContent = salah;
  document.getElementById('rSkor').textContent = finalScore;
  document.getElementById('rXpTotal').textContent = state.xp;
  document.getElementById('gradeRing').style.setProperty('--grade-deg', (finalScore/100*360) + 'deg');
  document.getElementById('rMsg').textContent = finalScore >= 70
    ? '🎯 Pertahankan semangat belajarmu! Lanjutkan ke Kuis 17 untuk materi Sriwijaya, Melayu Kuno & Sistem Pemerintahan.'
    : '📚 Pelajari kembali materi Teori Masuk & Kerajaan Awal, lalu coba lagi!';
  const reviewList = document.getElementById('reviewList');
  reviewList.innerHTML = '';
  state.answers.forEach((a, i) => {
    const div = document.createElement('div');
    div.className = 'review-item';
    const status = a.skipped ? '<span class="ri-status skipped">Dilewati</span>' :
                   a.correct ? '<span class="ri-status correct">Benar</span>' :
                   '<span class="ri-status wrong">Salah</span>';
    const q = a.questionText.length > 80 ? a.questionText.substring(0, 80) + '...' : a.questionText;
    div.innerHTML = `<span class="ri-num">${i+1}.</span><span class="ri-text">${q}</span>${status}`;
    reviewList.appendChild(div);
  });
  sfxFinish();
  if (finalScore >= 70){
    fireConfetti(180);
    setTimeout(() => fireConfetti(120), 400);
    setTimeout(() => showToast('🏆', 'Achievement Unlocked!', rank, ''), 500);
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function resetGame(){
  clearInterval(state.timer); state.timer = null;
  document.getElementById('resultScreen').classList.remove('active');
  document.getElementById('gameHud').classList.remove('active');
  document.getElementById('startScreen').style.display = 'flex';
  state.answers = []; state.score = 0; state.xp = 0; state.level = 1;
  state.hp = state.maxHp; state.combo = 0; state.bestCombo = 0;
  state.currentIndex = 0; state.finished = false; state.started = false;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.addEventListener('keydown', e => {
  if (!state.started || state.finished) return;
  const tag = (e.target.tagName || '').toLowerCase();
  if (tag === 'input' || tag === 'textarea') return;
  if (['a','A','1'].includes(e.key)) selectOption('A', document.querySelector('#options .opt[data-letter="A"]'));
  else if (['b','B','2'].includes(e.key)) selectOption('B', document.querySelector('#options .opt[data-letter="B"]'));
  else if (['c','C','3'].includes(e.key)) selectOption('C', document.querySelector('#options .opt[data-letter="C"]'));
  else if (['d','D','4'].includes(e.key)) selectOption('D', document.querySelector('#options .opt[data-letter="D"]'));
  else if (['e','E','5'].includes(e.key)) selectOption('E', document.querySelector('#options .opt[data-letter="E"]'));
  else if (e.key === 'ArrowRight' || e.key === 'Enter'){
    if (!document.getElementById('btnNext').disabled) nextQuestion();
  }
});
</script>


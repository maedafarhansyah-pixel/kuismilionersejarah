<body>

<div class="bg-layer"></div>
<div class="bg-grid"></div>
<canvas id="particles"></canvas>
<canvas id="confettiCanvas"></canvas>

<div id="loader">
  <div class="loader-orb">
    <div class="loader-core"><i class="fas fa-landmark"></i></div>
  </div>
  <div class="loader-title">HISTOEXPLORER</div>
  <div class="loader-sub">Kuis 16 · Teori Masuk &amp; Kerajaan Awal</div>
  <div class="loader-bar"><span id="loaderBar"></span></div>
  <div class="loader-pct" id="loaderPct">0%</div>
</div>

<header class="game-header">
  <div class="brand">
    <div class="brand-logo"><i class="fas fa-landmark"></i></div>
    <div class="brand-text">
      <span class="t1">KUIS 16 · HINDU-BUDDHA</span>

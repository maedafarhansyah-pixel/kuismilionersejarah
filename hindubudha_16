  box-shadow:0 0 24px rgba(245,158,11,.6)}
.toast-icon.green{background:linear-gradient(135deg,var(--emerald),#059669);box-shadow:0 0 24px rgba(52,211,153,.6)}
.toast-icon.cyan{background:linear-gradient(135deg,var(--accent),var(--accent-dark));box-shadow:0 0 24px rgba(59,130,246,.6)}
.toast-icon.violet{background:linear-gradient(135deg,var(--violet),#6C63FF);box-shadow:0 0 24px rgba(167,139,250,.6)}
.toast-content{flex:1;min-width:0}
.toast-title{font-size:.85rem;font-weight:900;color:var(--text);letter-spacing:.3px}
.toast-desc{font-size:.75rem;color:var(--text-dim);line-height:1.5;margin-top:2px}
.score-pop{position:fixed;z-index:9997;pointer-events:none;font-family:var(--font-display);
  font-weight:900;font-size:1.6rem;color:var(--primary-light);text-shadow:0 0 20px rgba(245,158,11,.8);
  animation:scorePop 1s var(--ease-out) forwards}
@keyframes scorePop{0%{transform:translate(-50%,0) scale(.5);opacity:0}
  20%{transform:translate(-50%,-20px) scale(1.2);opacity:1}
  100%{transform:translate(-50%,-80px) scale(1);opacity:0}}
@media (max-width:600px){
  .wrap{padding:calc(60px + 14px) 12px 50px}
  .q-card{padding:20px 18px}
  .opt{padding:13px 14px;font-size:.87rem;gap:11px}
  .opt-letter{width:30px;height:30px;font-size:.78rem}
  .hud-top{padding:12px 14px;gap:8px}
  .hud-timer{padding:6px 11px;font-size:.78rem}
  .hud-hp .heart{font-size:1rem}
  .power-btn{padding:9px 14px;font-size:.72rem}
  .btn{padding:12px 22px;font-size:.82rem;width:100%;justify-content:center}
  .action-bar{flex-direction:column}
  .result-hero{padding:28px 18px}
  .grade-ring{width:110px;height:110px}
  .grade-letter{font-size:2.2rem}
  .rs-val{font-size:1.4rem}
  .toast{max-width:calc(100vw - 24px);padding:12px 14px}
  .toast-icon{width:36px;height:36px;font-size:1rem}
}
@media print{
  .game-header,.power-bar,.action-bar,.bg-layer,.bg-grid,#particles,#confettiCanvas,#loader,.toast-wrap{display:none!important}
  body{background:#fff;color:#000}
}
</style>

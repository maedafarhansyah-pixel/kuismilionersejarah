function updateXpHud(){
  const xpForLevel = state.level * 100;
  const pct = Math.min((state.xp % xpForLevel) / xpForLevel * 100, 100);
  document.getElementById('hudLevel').textContent = state.level;
  document.getElementById('hudXp').textContent = state.xp % xpForLevel;
  document.getElementById('hudXpMax').textContent = xpForLevel;
  document.getElementById('xpFill').style.width = pct + '%';
}
function updateComboHud(){
  document.getElementById('comboVal').textContent = state.combo;
  const tag = document.getElementById('comboTag');
  if (state.combo >= 3){ tag.classList.add('hot'); setTimeout(()=>tag.classList.remove('hot'), 500); }
}
function updatePowers(){
  document.getElementById('c50').textContent = state.powers.p50;
  document.getElementById('chint').textContent = state.powers.hint;
  document.getElementById('cskip').textContent = state.powers.skip;
  document.getElementById('p50').disabled = state.powers.p50 <= 0;
  document.getElementById('phint').disabled = state.powers.hint <= 0;
  document.getElementById('pskip').disabled = state.powers.skip <= 0;

<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
<meta name="theme-color" content="#05060f" />
<title>🎮 Kuis 16 · Teori Masuk &amp; Kerajaan Awal Hindu-Buddha</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<style>
:root{
  --font-display:'Outfit',-apple-system,BlinkMacSystemFont,sans-serif;
  --font-mono:'Space Grotesk',ui-monospace,monospace;
  --primary:#F59E0B;--primary-light:#FCD34D;--primary-dark:#B45309;
  --accent:#3B82F6;--accent-light:#93C5FD;--accent-dark:#1E40AF;
  --emerald:#34D399;--violet:#A78BFA;--rose:#FB7185;--sky:#38BDF8;--gold:#FBBF24;
  --bg:#05060f;--bg-2:#0b0d1c;
  --glass:rgba(255,255,255,0.045);
  --glass-strong:rgba(255,255,255,0.08);
  --glass-border:rgba(255,255,255,0.10);
  --text:#f7f5ff;--text-dim:#a8a8c0;--text-mute:#6b6b85;
  --radius:24px;--radius-md:18px;--radius-sm:14px;--radius-xs:10px;
  --shadow-card:0 24px 60px rgba(0,0,0,.55);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--font-display);background:var(--bg);color:var(--text);line-height:1.65;
  overflow-x:hidden;min-height:100vh;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
::selection{background:var(--primary);color:#05060f}
.bg-layer{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 80% 60% at 20% 0%,rgba(245,158,11,.18),transparent 60%),
    radial-gradient(ellipse 70% 50% at 85% 100%,rgba(59,130,246,.14),transparent 60%),
    radial-gradient(ellipse 60% 50% at 50% 50%,rgba(252,211,77,.08),transparent 65%);
  animation:bgShift 20s ease-in-out infinite alternate}
@keyframes bgShift{0%{transform:scale(1) rotate(0deg);filter:hue-rotate(0deg)}100%{transform:scale(1.1) rotate(3deg);filter:hue-rotate(-10deg)}}
.bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.25;
  background-image:
    linear-gradient(rgba(245,158,11,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(245,158,11,.06) 1px,transparent 1px);
  background-size:52px 52px;
  mask-image:radial-gradient(ellipse 80% 70% at 50% 50%,#000,transparent 90%);
  -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 50%,#000,transparent 90%)}
#particles{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.7}
#confettiCanvas{position:fixed;inset:0;z-index:9998;pointer-events:none}
#loader{position:fixed;inset:0;z-index:99999;
  background:radial-gradient(ellipse at center,#0b0d1c 0%,#05060f 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:18px;padding:20px;text-align:center;transition:opacity .8s ease,visibility .8s ease}
#loader.hidden{opacity:0;visibility:hidden;pointer-events:none}
.loader-orb{width:120px;height:120px;position:relative;display:grid;place-items:center}
.loader-orb::before,.loader-orb::after{content:'';position:absolute;inset:0;border-radius:50%;border:2px solid transparent}
.loader-orb::before{border-top-color:var(--primary);border-right-color:var(--primary-light);animation:spin 2s linear infinite;filter:drop-shadow(0 0 20px rgba(245,158,11,.6))}
.loader-orb::after{inset:14px;border-bottom-color:var(--accent);border-left-color:var(--sky);animation:spin 1.6s linear infinite reverse}
@keyframes spin{to{transform:rotate(360deg)}}
.loader-core{width:56px;height:56px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  box-shadow:0 0 40px rgba(245,158,11,.7),inset 0 0 20px rgba(255,255,255,.25);
  display:grid;place-items:center;font-size:1.5rem;color:#fff;
  animation:pulseCore 2s ease-in-out infinite}
@keyframes pulseCore{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
.loader-title{font-family:var(--font-display);font-weight:900;font-size:clamp(1.6rem,6vw,2.6rem);letter-spacing:3px;
  background:linear-gradient(135deg,var(--primary-light),var(--primary),var(--accent));
  background-size:220% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  animation:shimmer 3s ease-in-out infinite}
@keyframes shimmer{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.loader-sub{font-size:.85rem;color:var(--text-dim);font-weight:500;letter-spacing:1px}
.loader-bar{width:min(300px,70vw);height:4px;background:rgba(255,255,255,.08);border-radius:10px;overflow:hidden}
.loader-bar span{display:block;height:100%;width:0;border-radius:10px;
  background:linear-gradient(90deg,var(--primary),var(--primary-light),var(--accent));
  box-shadow:0 0 20px rgba(245,158,11,.6);transition:width .3s ease}
.loader-pct{font-family:var(--font-mono);font-size:.72rem;font-weight:700;color:var(--text-mute);letter-spacing:2px}
.game-header{position:fixed;top:0;left:0;right:0;height:60px;z-index:1000;
  display:flex;align-items:center;justify-content:space-between;padding:0 16px;gap:10px;
  background:rgba(5,6,15,.72);backdrop-filter:blur(22px) saturate(160%);
  -webkit-backdrop-filter:blur(22px) saturate(160%);
  border-bottom:1px solid var(--glass-border)}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;font-size:.9rem;color:var(--text)}
.brand-logo{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;font-size:.9rem;
  box-shadow:0 0 22px rgba(245,158,11,.5);animation:logoPulse 3s ease-in-out infinite}
@keyframes logoPulse{0%,100%{box-shadow:0 0 22px rgba(245,158,11,.5)}50%{box-shadow:0 0 32px rgba(245,158,11,.8)}}
.brand-text{display:flex;flex-direction:column;line-height:1.1}
.brand-text .t1{font-size:.62rem;color:var(--text-mute);letter-spacing:1.5px;font-weight:600;text-transform:uppercase}
.brand-text .t2{font-size:.92rem;font-weight:800;color:var(--text)}
.header-actions{display:flex;gap:6px}
.icon-btn{width:36px;height:36px;border-radius:11px;border:1px solid var(--glass-border);
  background:var(--glass);color:var(--text-dim);display:grid;place-items:center;cursor:pointer;
  font-size:.85rem;transition:all .3s var(--ease-out)}
.icon-btn:hover{background:var(--primary);color:#fff;border-color:var(--primary);box-shadow:0 0 22px rgba(245,158,11,.6);transform:translateY(-2px)}
.wrap{position:relative;z-index:1;max-width:820px;margin:0 auto;
  padding:calc(60px + 20px) 16px 60px;min-height:100vh}
.start-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:calc(100vh - 100px);text-align:center;gap:18px;padding:20px 0}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 18px;border-radius:40px;
  background:linear-gradient(135deg,rgba(245,158,11,.18),rgba(59,130,246,.10));
  border:1px solid rgba(245,158,11,.30);font-size:.7rem;font-weight:800;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--primary-light);box-shadow:0 0 30px rgba(245,158,11,.20);
  animation:badgeFloat 3s ease-in-out infinite}
@keyframes badgeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.hero-title{font-family:var(--font-display);font-size:clamp(2rem,7vw,3.4rem);
  font-weight:900;line-height:1.05;letter-spacing:-1.5px;
  background:linear-gradient(135deg,#fff 0%,var(--primary-light) 40%,var(--primary) 70%,var(--accent) 100%);
  background-size:220% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  animation:shimmer 5s ease-in-out infinite;filter:drop-shadow(0 8px 30px rgba(245,158,11,.3))}
.hero-sub{font-size:clamp(.9rem,2vw,1.05rem);color:var(--text-dim);max-width:580px;line-height:1.75}
.hero-sub strong{color:var(--primary-light);font-weight:700}
.stats-showcase{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:8px}
.stat-pill{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:50px;
  background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(10px);
  font-size:.8rem;color:var(--text-dim);font-weight:600;transition:all .3s var(--ease-out)}
.stat-pill:hover{transform:translateY(-3px);border-color:rgba(245,158,11,.4);box-shadow:0 8px 24px rgba(245,158,11,.15)}
.stat-pill i{font-size:.95rem}
.rules-card{background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
  border:1px solid var(--glass-border);border-radius:var(--radius);padding:22px 24px;
  max-width:520px;width:100%;text-align:left;margin-top:6px;backdrop-filter:blur(14px);box-shadow:var(--shadow-card)}
.rules-card h4{font-size:.85rem;font-weight:800;color:var(--primary-light);margin-bottom:12px;
  display:flex;align-items:center;gap:9px;letter-spacing:.5px;text-transform:uppercase}
.rules-card ul{list-style:none;display:grid;gap:10px}
.rules-card li{display:flex;align-items:flex-start;gap:12px;font-size:.85rem;color:var(--text-dim);line-height:1.6}
.rule-num{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;
  border-radius:9px;flex-shrink:0;background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;font-size:.72rem;font-weight:900;box-shadow:0 4px 14px rgba(245,158,11,.4)}
.btn-play{position:relative;display:inline-flex;align-items:center;gap:14px;
  padding:18px 54px;border-radius:60px;border:none;
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;font-family:var(--font-display);font-weight:900;font-size:1.05rem;
  letter-spacing:1px;text-transform:uppercase;cursor:pointer;overflow:hidden;
  box-shadow:0 12px 40px rgba(245,158,11,.45),inset 0 -3px 0 rgba(0,0,0,.2);
  transition:all .4s var(--ease-spring);margin-top:14px}
.btn-play::before{content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent 30%,rgba(255,255,255,.35),transparent 70%);
  transform:translateX(-100%);transition:transform .8s ease}
.btn-play:hover{transform:translateY(-4px) scale(1.03);box-shadow:0 20px 60px rgba(245,158,11,.65)}
.btn-play:hover::before{transform:translateX(100%)}
.btn-play:active{transform:translateY(-1px) scale(.98)}
.game-hud{display:none;flex-direction:column;gap:14px;animation:fadeSlideIn .5s var(--ease-out)}
.game-hud.active{display:flex}
@keyframes fadeSlideIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.hud-top{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;
  padding:14px 18px;border-radius:var(--radius-md);
  background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
  border:1px solid var(--glass-border);backdrop-filter:blur(14px);box-shadow:var(--shadow-card)}
.hud-hp{display:flex;align-items:center;gap:4px}
.hud-hp .heart{font-size:1.15rem;color:var(--rose);
  filter:drop-shadow(0 0 8px rgba(251,113,133,.6));transition:all .4s var(--ease-out)}
.hud-hp .heart.empty{color:rgba(255,255,255,.10);filter:none;transform:scale(.85)}
.hud-hp .heart.losing{animation:heartBreak .6s ease}
@keyframes heartBreak{0%{transform:scale(1)}30%{transform:scale(1.4);color:#fff}100%{transform:scale(.85);opacity:.3}}
.hud-xp{display:flex;flex-direction:column;gap:4px;min-width:0}
.hud-xp-head{display:flex;justify-content:space-between;align-items:center;font-size:.65rem;font-weight:800;letter-spacing:1px;text-transform:uppercase}
.hud-xp-head .lvl{color:var(--primary-light)}
.hud-xp-head .val{color:var(--text-mute);font-family:var(--font-mono)}
.xp-track{height:8px;border-radius:10px;background:rgba(255,255,255,.06);overflow:hidden;position:relative}
.xp-fill{height:100%;width:0;border-radius:10px;
  background:linear-gradient(90deg,var(--primary),var(--primary-light),var(--accent));
  box-shadow:0 0 16px rgba(245,158,11,.7);transition:width .8s var(--ease-spring);position:relative}
.xp-fill::after{content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);
  animation:xpShine 2s linear infinite}
@keyframes xpShine{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.hud-timer{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:40px;
  background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.30);
  font-family:var(--font-mono);font-weight:800;font-size:.85rem;color:var(--primary-light);
  letter-spacing:1px;transition:all .3s ease}
.hud-timer.warning{background:rgba(251,113,133,.15);border-color:rgba(251,113,133,.5);color:#fecdd3;animation:pulseWarn 1s ease-in-out infinite}
@keyframes pulseWarn{0%,100%{box-shadow:0 0 0 0 rgba(251,113,133,.4)}50%{box-shadow:0 0 0 8px rgba(251,113,133,0)}}
.hud-middle{display:flex;align-items:center;justify-content:space-between;gap:10px;
  font-size:.75rem;color:var(--text-mute);font-weight:700;padding:0 4px}
.hud-middle .combo-tag{display:inline-flex;align-items:center;gap:6px;color:var(--accent);font-weight:800;transition:all .3s var(--ease-spring)}
.hud-middle .combo-tag.hot{color:var(--primary-light);animation:comboPulse .5s var(--ease-spring)}
@keyframes comboPulse{0%{transform:scale(1)}50%{transform:scale(1.25)}100%{transform:scale(1)}}
.q-card{position:relative;background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
  border:1px solid var(--glass-border);border-radius:var(--radius);padding:26px 26px 22px;
  backdrop-filter:blur(20px);box-shadow:var(--shadow-card);animation:qEnter .55s var(--ease-out);overflow:hidden}
.q-card::before{content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg,rgba(245,158,11,.4),transparent 40%,transparent 60%,rgba(59,130,246,.3));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
@keyframes qEnter{from{opacity:0;transform:translateY(30px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.q-card.shake{animation:shake .5s ease}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-10px)}40%{transform:translateX(10px)}60%{transform:translateX(-6px)}80%{transform:translateX(6px)}}
.q-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.q-num{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:30px;
  background:linear-gradient(135deg,rgba(245,158,11,.18),rgba(245,158,11,.06));
  border:1px solid rgba(245,158,11,.30);font-size:.72rem;font-weight:800;letter-spacing:1px;color:var(--primary-light)}
.q-topic{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:30px;
  background:rgba(59,130,246,.10);border:1px solid rgba(59,130,246,.28);font-size:.68rem;
  font-weight:800;letter-spacing:.8px;color:var(--accent);text-transform:uppercase}
.q-text{font-size:clamp(1rem,2.2vw,1.12rem);font-weight:600;line-height:1.75;color:var(--text);
  margin-bottom:20px;white-space:pre-line}
.q-text strong{color:var(--primary-light);font-weight:800}
.options{display:grid;gap:10px}
.opt{position:relative;display:flex;align-items:flex-start;gap:14px;width:100%;text-align:left;
  padding:15px 18px;border-radius:var(--radius-sm);border:1.5px solid var(--glass-border);
  background:rgba(255,255,255,.03);color:var(--text-dim);font-family:inherit;font-size:.92rem;
  line-height:1.6;cursor:pointer;transition:all .3s var(--ease-out);overflow:hidden}
.opt::before{content:'';position:absolute;left:0;top:0;bottom:0;width:0;
  background:linear-gradient(90deg,rgba(245,158,11,.15),transparent);
  transition:width .4s var(--ease-out);z-index:0}
.opt:hover:not(.locked){border-color:rgba(245,158,11,.55);transform:translateX(5px);
  color:var(--text);box-shadow:0 8px 24px rgba(245,158,11,.15)}
.opt:hover:not(.locked)::before{width:100%}
.opt-letter{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;
  width:34px;height:34px;border-radius:11px;flex-shrink:0;background:rgba(255,255,255,.06);
  color:var(--text-mute);font-weight:800;font-size:.85rem;transition:all .3s var(--ease-out);
  border:1px solid rgba(255,255,255,.06)}
.opt-text{position:relative;z-index:1;flex:1}
.opt:hover:not(.locked) .opt-letter{background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;border-color:transparent;box-shadow:0 0 20px rgba(245,158,11,.6)}
.opt.correct{border-color:var(--emerald);background:linear-gradient(135deg,rgba(52,211,153,.15),rgba(52,211,153,.05));
  color:#fff;pointer-events:none;box-shadow:0 0 0 3px rgba(52,211,153,.15),0 12px 32px rgba(52,211,153,.25);
  animation:correctPop .5s var(--ease-spring)}
@keyframes correctPop{0%{transform:scale(1)}40%{transform:scale(1.02)}100%{transform:scale(1)}}
.opt.correct .opt-letter{background:linear-gradient(135deg,var(--emerald),#059669);color:#fff;border-color:transparent;box-shadow:0 0 24px rgba(52,211,153,.7)}
.opt.wrong{border-color:var(--rose);background:linear-gradient(135deg,rgba(251,113,133,.15),rgba(251,113,133,.05));
  color:#fff;pointer-events:none;box-shadow:0 0 0 3px rgba(251,113,133,.15),0 12px 32px rgba(251,113,133,.25)}
.opt.wrong .opt-letter{background:linear-gradient(135deg,var(--rose),#be123c);color:#fff;border-color:transparent;box-shadow:0 0 24px rgba(251,113,133,.7)}
.opt.locked{pointer-events:none}
.opt.disabled-50{opacity:.2;pointer-events:none;filter:grayscale(1) blur(.5px)}
.feedback{display:none;padding:22px 24px;border-radius:var(--radius);
  background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
  border:1px solid var(--glass-border);backdrop-filter:blur(16px);box-shadow:var(--shadow-card);
  animation:qEnter .5s var(--ease-out)}
.feedback.show{display:block}
.fb-head{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.fb-icon{width:48px;height:48px;border-radius:15px;flex-shrink:0;display:grid;place-items:center;
  font-size:1.2rem;transition:all .4s var(--ease-spring)}
.fb-icon.correct{background:linear-gradient(135deg,var(--emerald),#059669);color:#fff;box-shadow:0 0 32px rgba(52,211,153,.6)}
.fb-icon.wrong{background:linear-gradient(135deg,var(--rose),#be123c);color:#fff;box-shadow:0 0 32px rgba(251,113,133,.6)}
.fb-icon.info{background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;box-shadow:0 0 32px rgba(245,158,11,.6)}
.fb-title{font-size:1.05rem;font-weight:900;letter-spacing:.5px;text-transform:uppercase}
.fb-title.correct{color:var(--emerald)}
.fb-title.wrong{color:#fecdd3}
.fb-title.info{color:var(--primary-light)}
.fb-body{font-size:.9rem;color:var(--text-dim);line-height:1.75}
.fb-body strong{color:var(--text);font-weight:700}
.fb-sec{margin-top:12px;padding-top:12px;border-top:1px dashed rgba(255,255,255,.10)}
.fb-label{font-size:.68rem;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--primary-light);margin-bottom:6px;display:flex;align-items:center;gap:6px}
.fb-points{margin-top:12px;padding:14px 16px;border-radius:12px;
  background:linear-gradient(135deg,rgba(59,130,246,.10),rgba(59,130,246,.03));border-left:3px solid var(--accent)}
.fb-points .fb-label{color:var(--accent)}
.fb-points p{font-size:.87rem;color:var(--text-dim);line-height:1.7}
.hud-bottom{display:flex;flex-direction:column;gap:12px}
.power-bar{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.power-btn{position:relative;display:inline-flex;align-items:center;gap:8px;padding:11px 20px;
  border-radius:50px;border:1px solid var(--glass-border);
  background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
  color:var(--text-dim);font-family:inherit;font-weight:800;font-size:.78rem;letter-spacing:.5px;
  cursor:pointer;transition:all .3s var(--ease-spring);overflow:hidden}
.power-btn i{font-size:.9rem}
.power-btn:hover:not(:disabled):not(.used){transform:translateY(-3px);border-color:rgba(245,158,11,.5);color:var(--text);box-shadow:0 8px 24px rgba(245,158,11,.25)}
.power-btn:active:not(:disabled):not(.used){transform:scale(.96)}

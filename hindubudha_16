      </div>
      <div class="action-bar">
        <button class="btn btn-primary" id="btnNext" onclick="nextQuestion()" disabled>
          Selanjutnya <i class="fas fa-arrow-right"></i>
        </button>
        <button class="btn btn-primary" id="btnFinish" onclick="finishGame()" style="display:none">
          Lihat Hasil <i class="fas fa-flag-checkered"></i>
        </button>
      </div>
    </div>
  </section>

  <section class="result-screen" id="resultScreen">

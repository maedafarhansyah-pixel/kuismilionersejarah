.review-item:hover{background:rgba(255,255,255,.06);transform:translateX(3px)}
.review-item .ri-num{font-weight:900;color:var(--text-mute);flex-shrink:0;font-family:var(--font-mono);font-size:.78rem;min-width:26px}
